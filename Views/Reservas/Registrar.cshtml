@model Reserva
@{ ViewData["Title"] = "Registrar reserva"; }
<h1>Registrar reserva</h1>
<p class="text-muted">Complete todos los campos. Se permiten hasta tres reservas por tipo de habitación.</p>
<form asp-action="Registrar" method="post" class="formulario">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
    <div class="mb-3">
        <label asp-for="NumeroHabitacion" class="form-label"></label>
        <input asp-for="NumeroHabitacion" class="form-control" maxlength="10" required />
        <span asp-validation-for="NumeroHabitacion" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="MontoTotal" class="form-label"></label>
        <input asp-for="MontoTotal" type="number" class="form-control" min="0.01" max="99999999.99" step="0.01" required />
        <span asp-validation-for="MontoTotal" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TipoHabitacion" class="form-label"></label>
        <select asp-for="TipoHabitacion" asp-items="ViewBag.Tipos" class="form-select" required>
            <option value="">Seleccione un tipo</option>
        </select>
        <span asp-validation-for="TipoHabitacion" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Guardar reserva</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Consultar reservas</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
