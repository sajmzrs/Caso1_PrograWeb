@model IEnumerable<Reserva>
@{ ViewData["Title"] = "Consultar reservas"; }
<h1>Consultar reservas</h1>
@if (TempData["Mensaje"] is string mensaje)
{ <div class="alert alert-success" role="status">@mensaje</div> }
@if (ViewBag.Error != null)
{ <div class="alert alert-danger" role="alert">@ViewBag.Error</div> }
else if (!Model.Any())
{ <p>No hay reservas registradas.</p> }
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th>Fecha de reserva</th><th>Número de habitación</th><th>Tipo de habitación</th><th class="text-end">Monto total</th></tr></thead>
            <tbody>
            @foreach (var reserva in Model)
            {
                <tr><td>@reserva.FechaReserva.ToString("dd/MM/yyyy")</td><td>@reserva.NumeroHabitacion</td><td>@reserva.DescripcionTipo</td><td class="text-end">@reserva.MontoTotal?.ToString("N2")</td></tr>
            }
            </tbody>
        </table>
    </div>
}
<a asp-action="Registrar" class="btn btn-primary">Registrar reserva</a>
